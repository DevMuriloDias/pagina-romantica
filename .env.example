# ───────────────────────── App ─────────────────────────
# URL pública (sem barra no final). Em dev: http://localhost:3000
APP_URL=http://localhost:3000
# Segredo para assinar tokens (magic links, sessões, cookies). Gere com: openssl rand -hex 32
APP_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# ───────────────────────── Banco ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amor?schema=public

# ───────────────────────── Armazenamento (S3/R2) ─────────────────────────
# STORAGE_DRIVER=s3 para R2/S3; "local" grava em ./.uploads (apenas dev/testes)
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=amor-em-pagina
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (domínio do R2 público ou CloudFront), sem barra no final
S3_PUBLIC_URL=https://cdn.seudominio.com.br

# ───────────────────────── Pagamentos (Mercado Pago) ─────────────────────────
# PAYMENTS_PROVIDER=mercadopago | mock  ("mock" simula Pix/cartão localmente — dev e E2E)
PAYMENTS_PROVIDER=mock
# Credenciais de TESTE em sandbox (APP_USR-... da conta de teste) ou produção
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Segredo da assinatura do webhook (Suas integrações > Webhooks > Assinatura secreta). Obrigatório também no modo mock.
MP_WEBHOOK_SECRET=troque-este-segredo-do-webhook
# Minutos até o Pix expirar
PIX_EXPIRATION_MINUTES=30
# Máximo de parcelas no cartão
CARD_MAX_INSTALLMENTS=12

# ───────────────────────── E-mail (Resend) ─────────────────────────
# Sem RESEND_API_KEY os e-mails são apenas registrados no banco (EmailLog) e no console.
RESEND_API_KEY=
EMAIL_FROM="Amor em Página <ola@seudominio.com.br>"
EMAIL_REPLY_TO=suporte@seudominio.com.br

# ───────────────────────── IA (Anthropic) ─────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Gerações por rascunho e por IP (janela de 24h)
AI_MAX_PER_DRAFT=30
AI_MAX_PER_IP=60
# Fallback de modelo em caso de recusa (beta server-side-fallback). 1 = ligado
AI_SERVER_FALLBACK=1

# ───────────────────────── Rate limit (Upstash Redis) ─────────────────────────
# Sem estas variáveis, usa limitador em memória (apenas 1 instância / dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────── Mapas ─────────────────────────
# Identificação exigida pela política de uso do Nominatim
NOMINATIM_USER_AGENT="AmorEmPagina/1.0 (contato@seudominio.com.br)"

# ───────────────────────── Cron / Admin ─────────────────────────
# Enviado como "Authorization: Bearer <CRON_SECRET>" pelas rotas /api/cron/*
CRON_SECRET=troque-este-segredo
# Admin inicial criado pelo seed
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha
# Dias até apagar rascunhos não pagos
DRAFT_RETENTION_DAYS=30
